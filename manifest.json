{
  "manifest_version": 3,
  "name": "Minha Agenda",
  "version": "1.3.0",
  "description": "Agenda pessoal com compromissos, tarefas, lembretes e sincronização com Google Calendar.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Minha Agenda",
    "default_popup": "popup.html"
  },
  "options_page": "agenda.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "SUBSTITUA_PELO_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events"
    ]
  }
}